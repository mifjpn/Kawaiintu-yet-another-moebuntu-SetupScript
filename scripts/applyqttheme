#!/bin/bash
# Kawaiintu Setup Helper - Apply GTK Theme to Qt Apps

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m      Configuring Qt Apps Theme          \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

echo ">> Installing Qt-GTK integration packages..."
sudo apt update >/dev/null 2>&1
sudo apt -y install qt5-gtk-platformtheme qt6-gtk-platformtheme qtwayland5

echo ">> Setting environment variables for Qt..."
QT_ENV_FILE="/etc/profile.d/kawaiintu-qt-theme.sh"

sudo bash -c "cat << 'EOF' > $QT_ENV_FILE
# Force Qt applications to use the GTK3 theme engine
export QT_QPA_PLATFORMTHEME=gtk3
EOF"

sudo chmod +x "$QT_ENV_FILE"

echo ">> Done. Qt applications will now respect your GTK theme."
echo ">> (Note: Theme changes will fully take effect after the next login)"
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
