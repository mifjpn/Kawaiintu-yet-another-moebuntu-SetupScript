#!/bin/bash
# Kawaiintu Setup Helper - Set Plymouth Wrapper

# ==== Variables ====
# Corrected to proper repository URL
BASE_URL="https://github.com/mifjpn/Kawaiintu-yet-another-moebuntu-MifjpnsOriginal/raw/main"
PLYMOUTH_ARCHIVE="kawaii_plymouth.tar.xz"
PLYMOUTH_URL="${BASE_URL}/plymouth/${PLYMOUTH_ARCHIVE}"
TEMP_DIR="Kawaiintu.plymouth.temp"

# Ask Y/N function
askyn() {
  while read -r -n 1 -s answer; do
    if [[ $answer = [YyNn] ]]; then
      [[ $answer = [Yy] ]] && retval=0
      [[ $answer = [Nn] ]] && retval=1
      break
    fi
  done
  echo "" # Line break
  return $retval
}

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m    Installing Kawaiintu Plymouth Theme  \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Download and extract archive
echo ">> Creating temporary directory ($TEMP_DIR)..."
mkdir -p "$TEMP_DIR"

echo ">> Downloading Plymouth archive..."
curl -L "$PLYMOUTH_URL" --output "$TEMP_DIR/$PLYMOUTH_ARCHIVE" >/dev/null 2>&1

echo ">> Extracting archive..."
tar -Jxf "$TEMP_DIR/$PLYMOUTH_ARCHIVE" -C "$TEMP_DIR" >/dev/null 2>&1

# Dynamically find install.sh and directory using find command
INSTALL_SCRIPT=$(find "$TEMP_DIR" -name "install.sh" | head -n 1)
EXTRACT_PATH=$(dirname "$INSTALL_SCRIPT")

if [ -z "$INSTALL_SCRIPT" ]; then
    echo ">> Error: install.sh not found."
    rm -rf "$TEMP_DIR"
    exit 1
fi

# 2. Install base theme (install.sh)
echo ">> Executing base installation (Administrator privileges required)..."
echo "   (This may take a minute as it updates initramfs)"
sudo bash "$INSTALL_SCRIPT"

# 3. User interaction: Change background image
echo ""
echo -n ">> Would you like to set a custom background image? (Y/N): "
if askyn; then
    echo -e "\x1b[33;01m--------------------------------------------------------\x1b[39;49;00m"
    echo " Please drag-and-drop an image file here and press Enter."
    echo " (If you just press Enter without dropping a file, the background will be set to DEFAULT BLACK)"
    echo -e "\x1b[33;01m--------------------------------------------------------\x1b[39;49;00m"
    read -p "File drop > " FileDrop
    
    # Remove single quotes added by terminal during drag & drop
    CleanFileDrop=$(echo "$FileDrop" | tr -d \')
    
    echo ">> Applying background setting..."
    # Pass file path (or empty if none) to bg_change.sh
    if [ -f "$EXTRACT_PATH/bg_change.sh" ]; then
        sudo bash "$EXTRACT_PATH/bg_change.sh" "$CleanFileDrop"
    else
        echo ">> Error: bg_change.sh not found."
    fi
else
    echo ">> Keeping the default black background."
fi

# 4. Clean up
echo ">> Cleaning up temporary files..."
rm -rf "$TEMP_DIR"

echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
