#!/bin/bash
# Kawaiintu Setup Helper - Remove Gedit

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m             Removing Gedit              \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Restore default settings (Revert to Ubuntu standard gnome-text-editor)
echo ">> Restoring default text editor (gnome-text-editor)..."

# Restore GUI default
xdg-mime default org.gnome.TextEditor.desktop text/plain

# Revert CLI default to auto-selection (standard)
sudo update-alternatives --auto editor >/dev/null 2>&1 || true

# 2. Completely remove Gedit
echo ">> Purging Gedit and cleaning up dependencies..."
sudo apt purge -y gedit >/dev/null 2>&1
sudo apt autoremove -y >/dev/null 2>&1

echo ">> Gedit has been successfully removed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
