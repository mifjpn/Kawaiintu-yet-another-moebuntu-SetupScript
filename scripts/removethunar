#!/bin/bash
# Kawaiintu Setup Helper - Remove Thunar

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m             Removing Thunar             \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Remove from Dock and restore Nautilus (Bulletproof Regex Injection)
echo ">> Removing Thunar and restoring Nautilus to dock..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)
export FAVORITES

NEW_FAVORITES=$(python3 << 'EOF'
import os, re

# Safely get the raw string via environment variable
raw = os.environ.get('FAVORITES', '')

# Extract all desktop files perfectly regardless of formatting
favs = re.findall(r"'([^']+)'", raw)

# Find the current position of Thunar before removing it
insert_idx = -1
for i, app in enumerate(favs):
    if app in ['thunar.desktop', 'kawaiintu-thunar.desktop']:
        insert_idx = i
        break

# Remove all Thunar fragments
favs = [x for x in favs if x not in ['thunar.desktop', 'kawaiintu-thunar.desktop']]

# Restore Nautilus if it is missing
if 'org.gnome.Nautilus.desktop' not in favs:
    if insert_idx != -1:
        # Insert Nautilus exactly where Thunar used to be
        favs.insert(insert_idx, 'org.gnome.Nautilus.desktop')
    else:
        # If Thunar wasn't in the dock either, append Nautilus to the end
        favs.append('org.gnome.Nautilus.desktop')

# Format output for gsettings
print('[' + ', '.join([f"'{x}'" for x in favs]) + ']')
EOF
)

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Nautilus has been restored to favorites."

# 2. Terminate running Thunar processes
echo ">> Terminating running Thunar processes..."
sudo killall -q thunar >/dev/null 2>&1

# 3. Remove local menu icon override
echo ">> Removing local menu icon override..."
LOCAL_APP_DIR="$HOME/.local/share/applications"

# addthunarで追加したすべてのショートカットを確実に削除
rm -f "$LOCAL_APP_DIR/kawaiintu-thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar-settings.desktop"
rm -f "$LOCAL_APP_DIR/thunar-bulk-rename.desktop"

update-desktop-database "$LOCAL_APP_DIR" >/dev/null 2>&1 || true
echo ">> Local Thunar menu icon overrides removed."

# 4. Clean up XFCE terminal helper settings
echo ">> Resetting terminal settings for Thunar (XFCE base)..."
rm -f ~/.config/xfce4/helpers.rc
rm -f ~/.local/share/xfce4/helpers/custom-TerminalEmulator.desktop
# Remove empty directories
rmdir ~/.local/share/xfce4/helpers 2>/dev/null || true

# 5. Remove user configuration files
echo ">> Removing user configuration files..."
rm -rf "$HOME/.config/Thunar"
rm -rf "$HOME/.config/thunar"
# Clean up script execution prompt settings
rm -f "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml"
# Clean up empty directories
rmdir "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml" 2>/dev/null || true
rmdir "$HOME/.config/xfce4/xfconf" 2>/dev/null || true
rmdir "$HOME/.config/xfce4" 2>/dev/null || true

# 6. Purge packages and clean dependencies
echo ">> Purging Thunar and cleaning up packages..."
# Explicitly purge only Thunar components to avoid collateral damage to Nemo
sudo apt purge -y thunar thunar-archive-plugin thunar-volman >/dev/null 2>&1
sudo apt autoremove -y >/dev/null 2>&1

# 7. Reset default file manager to Nautilus (GNOME standard)
xdg-mime default org.gnome.Nautilus.desktop inode/directory

echo ">> Thunar has been successfully removed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
