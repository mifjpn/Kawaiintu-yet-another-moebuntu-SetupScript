#!/bin/bash
# Kawaiintu Setup Helper - Remove Custom Sounds

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m  Removing Custom Sounds & Restoring     \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Restore sound theme settings to default (Yaru)
echo ">> Restoring default sound theme (Yaru)..."
gsettings set org.gnome.desktop.sound theme-name "Yaru"

# 2. Remove custom sounds from the system directory
echo ">> Removing custom sound files from system..."
# Specify to reliably delete both remnants of past MoeSound and future KawaiintuSound
sudo rm -rf /usr/share/sounds/Moe* /usr/share/sounds/Kawaiintu* >/dev/null 2>&1

echo ">> Sound settings restored successfully."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
exit 0
