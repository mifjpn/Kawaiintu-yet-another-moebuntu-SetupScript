#!/bin/bash
# Kawaiintu Icon Manager

COMMAND="$1"
TEMP_DIR="Kawaiintu.temp"

# GitHubのRaw URL（ご自身のリポジトリに合わせてパスを設定しています）
ICON_URL="https://raw.githubusercontent.com/mifjpn/Kawaiintu-yet-another-moebuntu-MifjpnsOriginal/main/icons/KawaiintuIcon.tar.xz"
ICON_ARCHIVE="KawaiintuIcon.tar.xz"

# 【追加】実行ユーザーを正しく判定する（SUDO_USERが空なら$USERを使う）
TARGET_USER="${SUDO_USER:-$USER}"

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m          Kawaiintu Icon Manager         \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

if [ "$COMMAND" = "install" ]; then
    echo ">> Creating temporary directory ($TEMP_DIR)..."
    mkdir -p "$TEMP_DIR"

    echo ">> Downloading $ICON_ARCHIVE..."
    curl -L "$ICON_URL" --output "$TEMP_DIR/$ICON_ARCHIVE" >/dev/null 2>&1

    echo ">> Extracting icons..."
    tar -Jxf "$TEMP_DIR/$ICON_ARCHIVE" -C "$TEMP_DIR" >/dev/null 2>&1

    ICON_DIR_NAME=$(ls -d "$TEMP_DIR"/*/ 2>/dev/null | head -n 1 | xargs basename)

    if [ -z "$ICON_DIR_NAME" ]; then
        echo ">> Error: Failed to extract or detect icon directory."
        rm -rf "$TEMP_DIR"
        exit 1
    fi

    echo ">> Copying $ICON_DIR_NAME to /usr/share/icons..."
    sudo cp -R "$TEMP_DIR/$ICON_DIR_NAME" /usr/share/icons/

    echo ">> Setting icon theme to $ICON_DIR_NAME..."
    # 【修正】判定したTARGET_USERで設定を適用する
    sudo -u "$TARGET_USER" dconf write /org/gnome/desktop/interface/icon-theme "'$ICON_DIR_NAME'" 2>/dev/null || \
    sudo -u "$TARGET_USER" gsettings set org.gnome.desktop.interface icon-theme "$ICON_DIR_NAME"

    echo ">> Installation complete."

    echo ">> Cleaning up temporary files..."
    rm -rf "$TEMP_DIR"

elif [ "$COMMAND" = "remove" ]; then
    echo ">> Restoring default Ubuntu icons (Yaru)..."
    # 【修正】判定したTARGET_USERで設定を適用する
    sudo -u "$TARGET_USER" dconf write /org/gnome/desktop/interface/icon-theme "'Yaru'" 2>/dev/null || \
    sudo -u "$TARGET_USER" gsettings set org.gnome.desktop.interface icon-theme "Yaru"

    echo ">> Removing Kawaiintu icons from system..."
    sudo rm -rf /usr/share/icons/Kawaiintu* /usr/share/icons/kawaiintu*

    echo ">> Removal complete."
else
    echo ">> Usage: ./iconmanager [install|remove]"
fi

echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
