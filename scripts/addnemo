#!/bin/bash
# Kawaiintu Setup Helper - Add Nemo

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Nemo                 \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Install via apt
echo ">> Updating apt and installing nemo..."
sudo apt update >/dev/null 2>&1
sudo apt -y install nemo

# 2. Add to Dock (Favorites) - Firefox Safe Logic
echo ">> Replacing Nautilus with Nemo in dock favorites..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)

# Remove existing Nemo icons to prevent duplicates
CLEAN_FAVORITES=$(echo "$FAVORITES" | sed -e "s/'nemo.desktop', //g" -e "s/, 'nemo.desktop'//g" -e "s/'nemo.desktop'//g")

if [[ "$CLEAN_FAVORITES" == *"'org.gnome.Nautilus.desktop'"* ]]; then
    # If Nautilus exists, replace it directly in its current position
    NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed "s/'org.gnome.Nautilus.desktop'/'nemo.desktop'/g")
else
    # If Nautilus is not found, append Nemo to the end
    NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed "s/\]/, 'nemo.desktop'\]/" | sed "s/\[, /\[/")
fi

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Nautilus replaced by Nemo in favorites."

echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
