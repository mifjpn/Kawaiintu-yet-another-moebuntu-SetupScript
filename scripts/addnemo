#!/bin/bash
# Kawaiintu Setup Helper - Add Nemo

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Nemo                 \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# ---------------------------------------------------------
# 0. Dependency Check: Auto-install Tilix & Gedit if missing
# ---------------------------------------------------------
if [ ! -f /usr/local/bin/tilix-wrapper ]; then
    echo -e "\x1b[33;01m>> Tilix (wrapper) is not installed. Automatically running addtilix first...\x1b[39;49;00m"
    if [ -f "./addtilix" ]; then
        /bin/bash ./addtilix
        echo -e "\n\x1b[32;01m>> Returning to file manager installation...\x1b[39;49;00m\n"
    else
        echo -e "\x1b[31;01m>> Warning: ./addtilix script not found! Proceeding without Tilix...\x1b[39;49;00m"
    fi
fi

if ! command -v gedit >/dev/null 2>&1; then
    echo -e "\x1b[33;01m>> Gedit is not installed. Automatically running addgedit first...\x1b[39;49;00m"
    if [ -f "./addgedit" ]; then
        /bin/bash ./addgedit
        echo -e "\n\x1b[32;01m>> Returning to file manager installation...\x1b[39;49;00m\n"
    else
        echo -e "\x1b[31;01m>> Warning: ./addgedit script not found! Proceeding without Gedit...\x1b[39;49;00m"
    fi
fi

# 1. Install via apt
echo ">> Updating apt and installing nemo..."
sudo apt update >/dev/null 2>&1
sudo apt -y install nemo

# ---------------------------------------------------------
# 2. Add to Dock (Favorites) - Bulletproof Regex Injection
# ---------------------------------------------------------
echo ">> Replacing Nautilus and setting Nemo strictly below Firefox..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)
export FAVORITES

# Use a Python heredoc with regex to completely avoid string parsing errors
NEW_FAVORITES=$(python3 << 'EOF'
import os, re

raw = os.environ.get('FAVORITES', '')
favs = re.findall(r"'([^']+)'", raw)

excludes = ['org.gnome.Nautilus.desktop', 'nemo.desktop']
favs = [x for x in favs if x not in excludes]

ff_idx = -1
for i, app in enumerate(favs):
    if app in ['firefox.desktop', 'firefox_firefox.desktop']:
        ff_idx = i
        break

if ff_idx != -1:
    favs.insert(ff_idx + 1, 'nemo.desktop')
else:
    favs.insert(1, 'nemo.desktop')

print('[' + ', '.join([f"'{x}'" for x in favs]) + ']')
EOF
)

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Nemo is now placed correctly in favorites."

# ---------------------------------------------------------
# 3. Fix Nemo Terminal Execution (Cinnamon Native Integration)
# ---------------------------------------------------------
echo ">> Configuring native terminal settings for Nemo (Cinnamon base)..."
if [ -f /usr/local/bin/tilix-wrapper ]; then
    NEMO_TERM="/usr/local/bin/tilix-wrapper"
else
    NEMO_TERM="x-terminal-emulator"
fi

gsettings set org.cinnamon.desktop.default-applications.terminal exec "$NEMO_TERM" 2>/dev/null || true
gsettings set org.cinnamon.desktop.default-applications.terminal exec-arg "-e" 2>/dev/null || true

# ---------------------------------------------------------
# 4. Set as default file manager & Create dummy templates
# ---------------------------------------------------------
xdg-mime default nemo.desktop inode/directory

# Create templates for both English and Japanese environments
mkdir -p ~/Templates 2>/dev/null
touch ~/Templates/"Text File.txt" 2>/dev/null

mkdir -p ~/テンプレート 2>/dev/null
touch ~/テンプレート/"Text File.txt" 2>/dev/null

echo ">> Nemo setup is fully completed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
