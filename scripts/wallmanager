#!/bin/bash
# Kawaiintu Setup Helper - Wallpaper Manager

# ==== Variables ====
# Corrected to the actual GitHub repository and file name
BASE_URL="https://github.com/mifjpn/Kawaiintu-yet-another-moebuntu-MifjpnsOriginal/raw/main/themes"
EXAMPLE_WALL_ARCHIVE="background.jpg"
EXAMPLE_WALL_URL="${BASE_URL}/${EXAMPLE_WALL_ARCHIVE}"

SYS_WALL_DIR="/usr/share/backgrounds"
DEFAULT_WALL_FILENAME="warty-final-ubuntu.png"
TEMP_DIR="Kawaiintu.wall.temp"
DEST_FILENAME_BASE="kawaiintu_wall"

ACTION="$1"

# Ask Y/N function
askyn() {
  while read -r -n 1 -s answer; do
    if [[ $answer = [YyNn] ]]; then
      [[ $answer = [Yy] ]] && retval=0
      [[ $answer = [Nn] ]] && retval=1
      break
    fi
  done
  echo ""
  return $retval
}

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m       Kawaiintu Wallpaper Manager       \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

if [ "$ACTION" = "install" ]; then
  # 1. Dependency check
  if ! dpkg -s curl >/dev/null 2>&1; then
    echo ">> Installing curl..."
    sudo apt update >/dev/null 2>&1
    sudo apt install -y curl >/dev/null 2>&1
  fi
  if ! command -v convert >/dev/null 2>&1; then
    echo ">> Installing imagemagick..."
    sudo apt update >/dev/null 2>&1
    sudo apt install -y imagemagick >/dev/null 2>&1
  fi

  mkdir -p "$TEMP_DIR"

  # 2. User interaction: Drag & Drop image
  echo -e "\x1b[33;01m--------------------------------------------------------\x1b[39;49;00m"
  echo " Please drag-and-drop an image file here and press Enter."
  echo " (If you just press Enter, the Kawaiintu example wallpaper will be used)"
  echo -e "\x1b[33;01m--------------------------------------------------------\x1b[39;49;00m"
  read -p "File drop > " FileDrop
  
  if [ -z "$FileDrop" ]; then
    # If empty Enter: Download default sample image
    echo -n ">> Do you want to apply the Kawaiintu example wallpaper? (Y/N): "
    if ! askyn; then
      echo ">> Canceled."
      rm -rf "$TEMP_DIR"
      echo -n "Hit Any Key to return to menu: "
      read -r -n 1 -s answer
      echo ""
      exit 0
    fi
    
    echo ">> Downloading example wallpaper..."
    curl -L "$EXAMPLE_WALL_URL" --output "$TEMP_DIR/$EXAMPLE_WALL_ARCHIVE" >/dev/null 2>&1
    
    TARGET_EXT="jpg"
    DEST_PATH="$SYS_WALL_DIR/${DEST_FILENAME_BASE}.${TARGET_EXT}"
    sudo cp "$TEMP_DIR/$EXAMPLE_WALL_ARCHIVE" "$DEST_PATH"
    
  else
    # If file is Drag & Dropped
    WallFileFullPath=$(echo "$FileDrop" | tr -d \')
    
    if [ ! -f "$WallFileFullPath" ]; then
      echo ">> Error: File not found ($WallFileFullPath)"
      rm -rf "$TEMP_DIR"
      echo -n "Hit Any Key to return to menu: "
      read -r -n 1 -s answer
      echo ""
      exit 0
    fi
    
    # Extension detection and conversion
    FileExtension="${WallFileFullPath##*.}"
    # Convert to lowercase for comparison
    FileExtensionLower=$(echo "$FileExtension" | tr '[:upper:]' '[:lower:]')
    
    if [ "$FileExtensionLower" = "jpg" ] || [ "$FileExtensionLower" = "jpeg" ] || [ "$FileExtensionLower" = "png" ]; then
      TARGET_EXT="$FileExtensionLower"
      DEST_PATH="$SYS_WALL_DIR/${DEST_FILENAME_BASE}.${TARGET_EXT}"
      echo ">> Copying image to system directory..."
      sudo cp "$WallFileFullPath" "$DEST_PATH"
    else
      echo ">> Not a standard JPG/PNG. Converting to PNG..."
      TARGET_EXT="png"
      DEST_PATH="$SYS_WALL_DIR/${DEST_FILENAME_BASE}.${TARGET_EXT}"
      
      if ! convert "$WallFileFullPath" "$TEMP_DIR/${DEST_FILENAME_BASE}.png"; then
         echo ">> Error: Failed to convert image."
         rm -rf "$TEMP_DIR"
         exit 0
      fi
      sudo cp "$TEMP_DIR/${DEST_FILENAME_BASE}.png" "$DEST_PATH"
    fi
  fi

  # 3. Apply wallpaper to GNOME (Supports both Light/Dark)
  echo ">> Setting background image..."
  gsettings set org.gnome.desktop.background picture-uri "file://$DEST_PATH"
  gsettings set org.gnome.desktop.background picture-uri-dark "file://$DEST_PATH"
  
  echo ">> Wallpaper successfully applied."

elif [ "$ACTION" = "remove" ]; then
  # Removal process (Restore to default)
  echo ">> Restoring default Ubuntu wallpaper..."
  gsettings set org.gnome.desktop.background picture-uri "file://$SYS_WALL_DIR/$DEFAULT_WALL_FILENAME"
  gsettings set org.gnome.desktop.background picture-uri-dark "file://$SYS_WALL_DIR/$DEFAULT_WALL_FILENAME"
  
  echo ">> Removing custom wallpapers from system..."
  sudo rm -f "$SYS_WALL_DIR/${DEST_FILENAME_BASE}."*
  
  echo ">> Restore complete."

else
  echo ">> Usage: $0 {install|remove}"
fi

# 4. Clean up
if [ -d "$TEMP_DIR" ]; then
  rm -rf "$TEMP_DIR"
fi

echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
