#!/bin/bash
# Kawaiintu Setup Helper - Remove VLC Media Player

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m          Removing VLC Media Player      \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 無駄な apt update を撤廃し、即座にパージとクリーンアップを実行
echo ">> Purging VLC and cleaning up packages..."
sudo apt purge -y vlc >/dev/null 2>&1
sudo apt autoremove -y >/dev/null 2>&1

echo ">> VLC has been successfully removed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
