#!/bin/bash
# Kawaiintu Setup Helper - Add Tilix

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Tilix                \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

echo ">> Updating apt and installing Tilix & dconf-cli..."
sudo apt update >/dev/null 2>&1
sudo apt -y install tilix dconf-cli

echo ">> Creating tilix-wrapper for File Manager integration..."
sudo tee /usr/local/bin/tilix-wrapper > /dev/null << 'EOF'
#!/bin/bash
if [ $# -eq 0 ]; then
    exec tilix
elif [ -d "$1" ]; then
    exec tilix --working-directory="$1"
else
    exec tilix -e "$@"
fi
EOF

sudo chmod +x /usr/local/bin/tilix-wrapper

echo ">> Setting Tilix Wrapper as default x-terminal-emulator..."
sudo update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/local/bin/tilix-wrapper 100 >/dev/null 2>&1 || true
sudo update-alternatives --set x-terminal-emulator /usr/local/bin/tilix-wrapper >/dev/null 2>&1 || true

# ---------------------------------------------------------
# Configure Tilix: GTK UI with Black Terminal Background
# ---------------------------------------------------------
echo ">> Configuring Tilix to use GTK UI with Black Background..."

# 1. Get current default profile ID
PROFILE_ID=$(gsettings get com.gexperts.Tilix.ProfilesList default 2>/dev/null | tr -d \')

if [ -z "$PROFILE_ID" ] || [ "$PROFILE_ID" == "null" ]; then
    PROFILE_ID="2b7c4080-0ddd-46c5-8f23-563fd3ba789d"
    gsettings set com.gexperts.Tilix.ProfilesList default "'$PROFILE_ID'" 2>/dev/null || true
fi

# 2. Follow system GTK theme for overall UI
gsettings set com.gexperts.Tilix.Settings theme-variant 'system' 2>/dev/null || true

# 3. Disable theme sync for terminal text area, force black background and white text
dconf write /com/gexperts/Tilix/profiles/${PROFILE_ID}/use-theme-colors false 2>/dev/null || true
dconf write /com/gexperts/Tilix/profiles/${PROFILE_ID}/background-color "'#000000'" 2>/dev/null || true
dconf write /com/gexperts/Tilix/profiles/${PROFILE_ID}/foreground-color "'#FFFFFF'" 2>/dev/null || true

echo ">> Tilix setup is fully completed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
