#!/bin/bash
# Kawaiintu Setup Helper - Login Sound Autostart Manager

ACTION="$1"
AUTOSTART_DIR="$HOME/.config/autostart"
DESKTOP_FILE="login-sound.desktop"

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m      Kawaiintu Login Sound Manager      \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

if [ "$ACTION" = "install" ]; then
  echo ">> Enabling login sound autostart..."
  mkdir -p "$AUTOSTART_DIR"
  
  if [ -f "$DESKTOP_FILE" ]; then
    cp "$DESKTOP_FILE" "$AUTOSTART_DIR/"
    echo ">> Login sound enabled successfully."
  else
    echo ">> Error: $DESKTOP_FILE not found in the current directory."
  fi

elif [ "$ACTION" = "remove" ]; then
  echo ">> Disabling login sound autostart..."
  if [ -f "$AUTOSTART_DIR/$DESKTOP_FILE" ]; then
    rm -f "$AUTOSTART_DIR/$DESKTOP_FILE"
    echo ">> Login sound disabled."
  else
    echo ">> Login sound autostart is already disabled."
  fi

else
  echo ">> Usage: $0 {install|remove}"
fi

exit 0
