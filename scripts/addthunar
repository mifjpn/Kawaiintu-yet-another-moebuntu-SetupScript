#!/bin/bash
# Kawaiintu Setup Helper - Add Thunar

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Thunar               \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# ---------------------------------------------------------
# 0. Dependency Check: Auto-install Tilix & Gedit if missing
# ---------------------------------------------------------
if ! command -v tilix >/dev/null 2>&1; then
    echo -e "\x1b[33;01m>> Tilix is not installed. Automatically running addtilix first...\x1b[39;49;00m"
    if [ -f "./addtilix" ]; then
        /bin/bash ./addtilix
        echo -e "\n\x1b[32;01m>> Returning to file manager installation...\x1b[39;49;00m\n"
    else
        echo -e "\x1b[31;01m>> Warning: ./addtilix script not found! Proceeding without Tilix...\x1b[39;49;00m"
    fi
fi

if ! command -v gedit >/dev/null 2>&1; then
    echo -e "\x1b[33;01m>> Gedit is not installed. Automatically running addgedit first...\x1b[39;49;00m"
    if [ -f "./addgedit" ]; then
        /bin/bash ./addgedit
        echo -e "\n\x1b[32;01m>> Returning to file manager installation...\x1b[39;49;00m\n"
    else
        echo -e "\x1b[31;01m>> Warning: ./addgedit script not found! Proceeding without Gedit...\x1b[39;49;00m"
    fi
fi

# 1. Install via apt (thunar-volman excluded)
echo ">> Updating apt and installing Thunar & Archive tools..."
sudo apt update >/dev/null 2>&1
sudo apt -y install thunar thunar-archive-plugin file-roller zip unzip xz-utils zenity exo-utils

# ---------------------------------------------------------
# 2. Fix Thunar icons (Main, Settings, Bulk Rename)
# ---------------------------------------------------------
echo ">> Configuring local menu icons for Thunar..."
LOCAL_APP_DIR="$HOME/.local/share/applications"
mkdir -p "$LOCAL_APP_DIR"

# Clean up old overrides to restore correct icons for Settings and Bulk Rename
rm -f "$LOCAL_APP_DIR/kawaiintu-thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar-settings.desktop"
rm -f "$LOCAL_APP_DIR/thunar-bulk-rename.desktop"

# Main Thunar
if [ -f /usr/share/applications/thunar.desktop ]; then
    cp /usr/share/applications/thunar.desktop "$LOCAL_APP_DIR/"
    sed -i 's/^Icon=.*/Icon=system-file-manager/' "$LOCAL_APP_DIR/thunar.desktop"
    if ! grep -q "^StartupWMClass=" "$LOCAL_APP_DIR/thunar.desktop"; then
        echo "StartupWMClass=Thunar" >> "$LOCAL_APP_DIR/thunar.desktop"
    fi
    sed -i '/^Name\[/d' "$LOCAL_APP_DIR/thunar.desktop"
    sed -i '/^GenericName\[/d' "$LOCAL_APP_DIR/thunar.desktop"
    chmod +x "$LOCAL_APP_DIR/thunar.desktop"
fi

# Thunar Settings
if [ -f /usr/share/applications/thunar-settings.desktop ]; then
    cp /usr/share/applications/thunar-settings.desktop "$LOCAL_APP_DIR/"
    sed -i 's/^Icon=.*/Icon=preferences-system/' "$LOCAL_APP_DIR/thunar-settings.desktop"
    sed -i '/^Name\[/d' "$LOCAL_APP_DIR/thunar-settings.desktop"
    chmod +x "$LOCAL_APP_DIR/thunar-settings.desktop"
fi

# Thunar Bulk Rename
if [ -f /usr/share/applications/thunar-bulk-rename.desktop ]; then
    cp /usr/share/applications/thunar-bulk-rename.desktop "$LOCAL_APP_DIR/"
    sed -i 's/^Icon=.*/Icon=accessories-text-editor/' "$LOCAL_APP_DIR/thunar-bulk-rename.desktop"
    sed -i '/^Name\[/d' "$LOCAL_APP_DIR/thunar-bulk-rename.desktop"
    chmod +x "$LOCAL_APP_DIR/thunar-bulk-rename.desktop"
fi

update-desktop-database "$LOCAL_APP_DIR" >/dev/null 2>&1 || true

# ---------------------------------------------------------
# 3. Add to Dock (Favorites)
# ---------------------------------------------------------
echo ">> Replacing Nautilus and setting Thunar strictly below Firefox..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)
export FAVORITES

NEW_FAVORITES=$(python3 << 'EOF'
import os, re
raw = os.environ.get('FAVORITES', '')
favs = re.findall(r"'([^']+)'", raw)
excludes = ['org.gnome.Nautilus.desktop', 'kawaiintu-thunar.desktop', 'thunar.desktop']
favs = [x for x in favs if x not in excludes]
ff_idx = -1
for i, app in enumerate(favs):
    if app in ['firefox.desktop', 'firefox_firefox.desktop']:
        ff_idx = i
        break
if ff_idx != -1:
    favs.insert(ff_idx + 1, 'thunar.desktop')
else:
    favs.insert(1, 'thunar.desktop')
print('[' + ', '.join([f"'{x}'" for x in favs]) + ']')
EOF
)

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Thunar is now placed correctly in favorites."

# ---------------------------------------------------------
# 4. FIX: Terminal Configuration & Execution Behavior
# ---------------------------------------------------------
echo ">> Halting XFCE configuration daemons to prevent overwrites..."
killall thunar xfconfd 2>/dev/null || true
sleep 1

echo ">> Configuring terminal settings and execution behavior..."
mkdir -p ~/.config/xfce4
cat << 'EOF' > ~/.config/xfce4/helpers.rc
[Configuration]
TerminalEmulator=tilix
EOF

mkdir -p ~/.config/xfce4/xfconf/xfce-perchannel-xml
THUNAR_XML="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml"

if [ ! -f "$THUNAR_XML" ]; then
    echo '<?xml version="1.0" encoding="UTF-8"?>' > "$THUNAR_XML"
    echo '<channel name="thunar" version="1.0">' >> "$THUNAR_XML"
    echo '  <property name="misc-exec-executable-scripts-by-default" type="string" value="execute"/>' >> "$THUNAR_XML"
    echo '</channel>' >> "$THUNAR_XML"
else
    if grep -q 'misc-exec-executable-scripts-by-default' "$THUNAR_XML"; then
        sed -i 's/"misc-exec-executable-scripts-by-default" type="string" value="[^"]*"/"misc-exec-executable-scripts-by-default" type="string" value="execute"/' "$THUNAR_XML"
    else
        sed -i 's|</channel>|  <property name="misc-exec-executable-scripts-by-default" type="string" value="execute"/>\n</channel>|' "$THUNAR_XML"
    fi
fi

# Thunar MUST see this file as "NoDisplay=false", otherwise it refuses to set it as default
cat << 'EOF' > ~/.local/share/applications/tilix-run-script.desktop
[Desktop Entry]
Name=Tilix (Run Script)
Exec=tilix -e "%f"
Icon=tilix
Type=Application
NoDisplay=false
MimeType=application/x-shellscript;application/x-executable;
EOF
update-desktop-database ~/.local/share/applications >/dev/null 2>&1 || true

# ---------------------------------------------------------
# 5. Inject custom actions & Cleanup
# ---------------------------------------------------------
echo ">> Injecting custom actions to Thunar (uca.xml)..."
UCA_DIR="$HOME/.config/Thunar"
UCA_FILE="$UCA_DIR/uca.xml"

mkdir -p "$UCA_DIR"

if [ ! -f "$UCA_FILE" ]; then
    if [ -f "/etc/xdg/Thunar/uca.xml" ]; then
        cp /etc/xdg/Thunar/uca.xml "$UCA_FILE"
    else
        echo '<?xml encoding="UTF-8" version="1.0"?><actions></actions>' > "$UCA_FILE"
    fi
fi

python3 -c "
import xml.etree.ElementTree as ET
import os

xml_file = os.path.expanduser('~/.config/Thunar/uca.xml')
if os.path.exists(xml_file):
    try:
        tree = ET.parse(xml_file)
        root = tree.getroot()
        changed = False
        for action in root.findall('action'):
            uid = action.find('unique-id')
            if uid is not None and uid.text in ['kawaiintu-tilix-here', 'kawaiintu-run-tilix']:
                root.remove(action)
                changed = True
        if changed:
            tree.write(xml_file, encoding='UTF-8', xml_declaration=True)
    except Exception:
        pass
"

if ! grep -q "kawaiintu-run-tilix" "$UCA_FILE"; then
    cat << 'EOF' > /tmp/thunar-custom-actions.xml
<action>
    <icon>tilix</icon>
    <name>Run in Tilix</name>
    <unique-id>kawaiintu-run-tilix</unique-id>
    <command>tilix -e "%f"</command>
    <description>Run shell script in Tilix</description>
    <patterns>*.sh;*.bin;*.run;*Kawaset*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
<action>
    <icon>application-zip</icon>
    <name>Compress to ZIP</name>
    <unique-id>kawaiintu-compress-zip</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="ZIP Compression" --text="Enter output filename:" --entry-text="Archive.zip"); if [ -n "$NAME" ]; then zip -r "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to ZIP</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
<action>
    <icon>application-x-xz-compressed-tar</icon>
    <name>Compress to tar.xz</name>
    <unique-id>kawaiintu-compress-tarxz</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="tar.xz Compression" --text="Enter output filename:" --entry-text="Archive.tar.xz"); if [ -n "$NAME" ]; then tar -cJf "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to tar.xz</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
EOF
    cp "$UCA_FILE" "${UCA_FILE}.bak"
    awk '/<\/actions>/{system("cat /tmp/thunar-custom-actions.xml")}1' "${UCA_FILE}.bak" > "$UCA_FILE"
    rm -f /tmp/thunar-custom-actions.xml
fi

# ---------------------------------------------------------
# 6. Set as default file manager & Text Editor
# ---------------------------------------------------------
echo ">> Setting defaults (Thunar, Gedit & Script Execution)..."
xdg-mime default thunar.desktop inode/directory

# Clear MIME cache to force system to re-read desktop files
rm -f ~/.local/share/applications/mimeinfo.cache
update-desktop-database ~/.local/share/applications >/dev/null 2>&1 || true

# Correctly mask Snap Text Editor so it doesn't show as "名前なし" (Unnamed)
mkdir -p ~/.local/share/applications
cat << 'EOF' > ~/.local/share/applications/gnome-text-editor_gnome-text-editor.desktop
[Desktop Entry]
Name=GNOME Text Editor (Snap)
Type=Application
Hidden=true
NoDisplay=true
EOF
cat << 'EOF' > ~/.local/share/applications/org.gnome.TextEditor.desktop
[Desktop Entry]
Name=GNOME Text Editor
Type=Application
Hidden=true
NoDisplay=true
EOF

# Force common apps to appear in English in the context menu
for app in org.gnome.gedit tilix file-roller org.gnome.FileRoller; do
    if [ -f "/usr/share/applications/${app}.desktop" ]; then
        cp "/usr/share/applications/${app}.desktop" ~/.local/share/applications/
        sed -i '/^Name\[/d' ~/.local/share/applications/${app}.desktop
        sed -i '/^GenericName\[/d' ~/.local/share/applications/${app}.desktop
        chmod +x ~/.local/share/applications/${app}.desktop
    fi
done

# Ensure Gedit is specifically named just "Gedit"
sed -i 's/^Name=.*/Name=Gedit/' ~/.local/share/applications/org.gnome.gedit.desktop 2>/dev/null || true
update-desktop-database ~/.local/share/applications >/dev/null 2>&1 || true

# Aggressively enforce defaults via mimeapps.list
MIME_FILE="$HOME/.config/mimeapps.list"
mkdir -p "$HOME/.config"
touch "$MIME_FILE"
if ! grep -q "^\[Default Applications\]" "$MIME_FILE"; then
    echo "[Default Applications]" >> "$MIME_FILE"
fi
if ! grep -q "^\[Added Associations\]" "$MIME_FILE"; then
    echo "" >> "$MIME_FILE"
    echo "[Added Associations]" >> "$MIME_FILE"
fi

# --- 1. Set Gedit as default ONLY for plain text files ---
for mime_type in text/plain; do
    sed -i "|^${mime_type}=.*|d" "$MIME_FILE"
    sed -i "/^\[Default Applications\]/a ${mime_type}=org.gnome.gedit.desktop;" "$MIME_FILE"
    xdg-mime default org.gnome.gedit.desktop "$mime_type" 2>/dev/null || true
    gio mime "$mime_type" org.gnome.gedit.desktop >/dev/null 2>&1 || true
done

# --- 2. Force Scripts to RUN on Double-Click, and add Gedit to Right-Click ---
for mime_type in application/x-shellscript application/x-executable; do
    # Completely remove any existing defaults for scripts (preventing fallback to Gedit)
    sed -i "|^${mime_type}=.*|d" "$MIME_FILE"
    
    # Set the absolute default for scripts to our Run wrapper
    sed -i "/^\[Default Applications\]/a ${mime_type}=tilix-run-script.desktop;" "$MIME_FILE"
    xdg-mime default tilix-run-script.desktop "$mime_type" 2>/dev/null || true
    gio mime "$mime_type" tilix-run-script.desktop >/dev/null 2>&1 || true
    
    # Add Gedit to the right-click "Open With" menu for editing
    sed -i "/^\[Added Associations\]/a ${mime_type}=org.gnome.gedit.desktop;" "$MIME_FILE"
done

echo ">> Thunar setup is fully completed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
