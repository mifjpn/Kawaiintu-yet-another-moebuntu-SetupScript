#!/bin/bash
# Kawaiintu Setup Helper - Add Thunar

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Thunar               \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Install via apt (along with compression/extraction tools)
echo ">> Updating apt and installing Thunar & Archive tools..."
sudo apt update >/dev/null 2>&1
# Add zenity for one-click compression and file-roller as standard extractor
sudo apt -y install thunar thunar-archive-plugin thunar-volman file-roller zip unzip xz-utils zenity

# ---------------------------------------------------------
# 2. Fix Thunar icon (Overwrite completely in ~/.local)
# ---------------------------------------------------------
echo ">> Configuring local menu icon for Thunar..."
LOCAL_APP_DIR="$HOME/.local/share/applications"
mkdir -p "$LOCAL_APP_DIR"

# Remove legacy files (e.g., kawaiintu-thunar) if they exist
rm -f "$LOCAL_APP_DIR/kawaiintu-thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar.desktop"

# Copy original system config file to local directory
if [ -f /usr/share/applications/thunar.desktop ]; then
    cp /usr/share/applications/thunar.desktop "$LOCAL_APP_DIR/"
    
    # Overwrite icon to GNOME standard generic file manager icon (Theme compatible)
    sed -i 's/^Icon=.*/Icon=system-file-manager/' "$LOCAL_APP_DIR/thunar.desktop"
    
    # Append StartupWMClass if it doesn't exist for reliable association
    if ! grep -q "^StartupWMClass=" "$LOCAL_APP_DIR/thunar.desktop"; then
        echo "StartupWMClass=Thunar" >> "$LOCAL_APP_DIR/thunar.desktop"
    fi
    
    update-desktop-database "$LOCAL_APP_DIR" >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------
# 3. Add to Dock (Favorites) - Firefox Safe Logic
# ---------------------------------------------------------
echo ">> Replacing Nautilus with Thunar in dock favorites..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)

# Remove existing Thunar or legacy icons to prevent duplicates
CLEAN_FAVORITES=$(echo "$FAVORITES" | sed -e "s/'kawaiintu-thunar.desktop', //g" -e "s/, 'kawaiintu-thunar.desktop'//g" -e "s/'kawaiintu-thunar.desktop'//g" \
                                          -e "s/'thunar.desktop', //g" -e "s/, 'thunar.desktop'//g" -e "s/'thunar.desktop'//g")

if [[ "$CLEAN_FAVORITES" == *"'org.gnome.Nautilus.desktop'"* ]]; then
    # If Nautilus exists, replace it directly in its current position
    NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed "s/'org.gnome.Nautilus.desktop'/'thunar.desktop'/g")
else
    # If Nautilus is not found, append Thunar to the end
    NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed "s/\]/, 'thunar.desktop'\]/" | sed "s/\[, /\[/")
fi

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Nautilus replaced by Thunar in favorites."

# ---------------------------------------------------------
# 4. Configure Thunar (XFCE) terminal call setting (Tilix wrapper support)
# ---------------------------------------------------------
echo ">> Configuring terminal settings for Thunar (XFCE base)..."
mkdir -p ~/.config/xfce4
mkdir -p ~/.local/share/xfce4/helpers

cat << 'EOF' > ~/.config/xfce4/helpers.rc
TerminalEmulator=custom-TerminalEmulator
EOF

if [ -f /usr/local/bin/tilix-wrapper ]; then
    WRAPPER_PATH="/usr/local/bin/tilix-wrapper"
else
    WRAPPER_PATH="x-terminal-emulator"
fi

cat << EOF > ~/.local/share/xfce4/helpers/custom-TerminalEmulator.desktop
[Desktop Entry]
NoDisplay=true
Version=1.0
Encoding=UTF-8
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
X-XFCE-CommandsWithParameter=$WRAPPER_PATH -e "%s"
Icon=tilix
Name=Custom Terminal Wrapper
EOF

# ---------------------------------------------------------
# 5. Inject custom actions (Compression & Tilix) to Thunar
# ---------------------------------------------------------
echo ">> Injecting custom actions to Thunar (uca.xml)..."
UCA_DIR="$HOME/.config/Thunar"
UCA_FILE="$UCA_DIR/uca.xml"

mkdir -p "$UCA_DIR"

# If uca.xml does not exist, copy from system default or create an empty structure
if [ ! -f "$UCA_FILE" ]; then
    if [ -f "/etc/xdg/Thunar/uca.xml" ]; then
        cp /etc/xdg/Thunar/uca.xml "$UCA_FILE"
    else
        echo '<?xml encoding="UTF-8" version="1.0"?><actions></actions>' > "$UCA_FILE"
    fi
fi

# Append Open in Tilix action if not already registered
if ! grep -q "kawaiintu-tilix-here" "$UCA_FILE"; then
    cat << 'EOF' > /tmp/thunar-tilix.xml
<action>
    <icon>tilix</icon>
    <name>Open in Tilix</name>
    <unique-id>kawaiintu-tilix-here</unique-id>
    <command>/usr/local/bin/tilix-wrapper "%f"</command>
    <description>Open Tilix terminal here</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
</action>
EOF
    cp "$UCA_FILE" "${UCA_FILE}.bak"
    awk '/<\/actions>/{system("cat /tmp/thunar-tilix.xml")}1' "${UCA_FILE}.bak" > "$UCA_FILE"
    rm -f /tmp/thunar-tilix.xml
fi

# Append ZIP and tar.xz actions if not already registered
if ! grep -q "kawaiintu-compress-zip" "$UCA_FILE"; then
    cat << 'EOF' > /tmp/thunar-compress.xml
<action>
    <icon>application-zip</icon>
    <name>Compress to ZIP</name>
    <unique-id>kawaiintu-compress-zip</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="ZIP Compression" --text="Enter output filename:" --entry-text="Archive.zip"); if [ -n "$NAME" ]; then zip -r "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to ZIP</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
<action>
    <icon>application-x-xz-compressed-tar</icon>
    <name>Compress to tar.xz</name>
    <unique-id>kawaiintu-compress-tarxz</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="tar.xz Compression" --text="Enter output filename:" --entry-text="Archive.tar.xz"); if [ -n "$NAME" ]; then tar -cJf "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to tar.xz</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
EOF
    cp "$UCA_FILE" "${UCA_FILE}.bak"
    awk '/<\/actions>/{system("cat /tmp/thunar-compress.xml")}1' "${UCA_FILE}.bak" > "$UCA_FILE"
    rm -f /tmp/thunar-compress.xml
fi

# ---------------------------------------------------------
# 6. Set as default file manager & Create dummy templates
# ---------------------------------------------------------
xdg-mime default thunar.desktop inode/directory

# Create dummy files to silence Thunar's missing template warning
mkdir -p ~/Templates 2>/dev/null
touch ~/Templates/"Text File.txt" 2>/dev/null

echo ">> Thunar setup is fully completed (with Custom Actions)."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
