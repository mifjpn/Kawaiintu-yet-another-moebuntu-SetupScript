#!/bin/bash
# Kawaiintu Setup Helper - Add Thunar

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Thunar               \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Install via apt
echo ">> Updating apt and installing Thunar & Archive tools..."
sudo apt update >/dev/null 2>&1
sudo apt -y install thunar thunar-archive-plugin thunar-volman file-roller zip unzip xz-utils zenity exo-utils

# ---------------------------------------------------------
# 2. Fix Thunar icon
# ---------------------------------------------------------
echo ">> Configuring local menu icon for Thunar..."
LOCAL_APP_DIR="$HOME/.local/share/applications"
mkdir -p "$LOCAL_APP_DIR"

rm -f "$LOCAL_APP_DIR/kawaiintu-thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar.desktop"

if [ -f /usr/share/applications/thunar.desktop ]; then
    cp /usr/share/applications/thunar.desktop "$LOCAL_APP_DIR/"
    sed -i 's/^Icon=.*/Icon=system-file-manager/' "$LOCAL_APP_DIR/thunar.desktop"
    if ! grep -q "^StartupWMClass=" "$LOCAL_APP_DIR/thunar.desktop"; then
        echo "StartupWMClass=Thunar" >> "$LOCAL_APP_DIR/thunar.desktop"
    fi
    update-desktop-database "$LOCAL_APP_DIR" >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------
# 3. Add to Dock (Favorites)
# ---------------------------------------------------------
echo ">> Replacing Nautilus and setting Thunar strictly below Firefox..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)
export FAVORITES

NEW_FAVORITES=$(python3 << 'EOF'
import os, re
raw = os.environ.get('FAVORITES', '')
favs = re.findall(r"'([^']+)'", raw)
excludes = ['org.gnome.Nautilus.desktop', 'kawaiintu-thunar.desktop', 'thunar.desktop']
favs = [x for x in favs if x not in excludes]
ff_idx = -1
for i, app in enumerate(favs):
    if app in ['firefox.desktop', 'firefox_firefox.desktop']:
        ff_idx = i
        break
if ff_idx != -1:
    favs.insert(ff_idx + 1, 'thunar.desktop')
else:
    favs.insert(1, 'thunar.desktop')
print('[' + ', '.join([f"'{x}'" for x in favs]) + ']')
EOF
)

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Thunar is now placed correctly in favorites."

# ---------------------------------------------------------
# 4. Configure Thunar Terminal Emulator
# ---------------------------------------------------------
echo ">> Configuring terminal settings for Thunar (XFCE base)..."
mkdir -p ~/.config/xfce4
mkdir -p ~/.local/share/xfce4/helpers

cat << 'EOF' > ~/.config/xfce4/helpers.rc
TerminalEmulator=custom-TerminalEmulator
EOF

cat << 'EOF' > ~/.local/share/xfce4/helpers/custom-TerminalEmulator.desktop
[Desktop Entry]
NoDisplay=true
Version=1.0
Encoding=UTF-8
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
X-XFCE-Commands=tilix;x-terminal-emulator;
X-XFCE-CommandsWithParameter=tilix -e "%s";x-terminal-emulator -e "%s";
Icon=tilix
Name=Custom Terminal Wrapper
EOF

# ---------------------------------------------------------
# 5. Fix Script Double-Click Behavior
# ---------------------------------------------------------
echo ">> Configuring Thunar to prompt execution for shell scripts..."
mkdir -p ~/.config/xfce4/xfconf/xfce-perchannel-xml
THUNAR_XML="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml"

if [ ! -f "$THUNAR_XML" ]; then
    echo '<?xml version="1.0" encoding="UTF-8"?>' > "$THUNAR_XML"
    echo '<channel name="thunar" version="1.0">' >> "$THUNAR_XML"
    echo '  <property name="misc-exec-executable-scripts-by-default" type="string" value="ask"/>' >> "$THUNAR_XML"
    echo '</channel>' >> "$THUNAR_XML"
else
    if ! grep -q 'misc-exec-executable-scripts-by-default' "$THUNAR_XML"; then
        sed -i 's|</channel>|  <property name="misc-exec-executable-scripts-by-default" type="string" value="ask"/>\n</channel>|' "$THUNAR_XML"
    else
        sed -i 's/"misc-exec-executable-scripts-by-default" type="string" value="[^"]*"/"misc-exec-executable-scripts-by-default" type="string" value="ask"/' "$THUNAR_XML"
    fi
fi

# ---------------------------------------------------------
# 6. Inject custom actions & Cleanup
# ---------------------------------------------------------
echo ">> Injecting custom actions to Thunar (uca.xml)..."
UCA_DIR="$HOME/.config/Thunar"
UCA_FILE="$UCA_DIR/uca.xml"

mkdir -p "$UCA_DIR"

if [ ! -f "$UCA_FILE" ]; then
    if [ -f "/etc/xdg/Thunar/uca.xml" ]; then
        cp /etc/xdg/Thunar/uca.xml "$UCA_FILE"
    else
        echo '<?xml encoding="UTF-8" version="1.0"?><actions></actions>' > "$UCA_FILE"
    fi
fi

python3 -c "
import xml.etree.ElementTree as ET
import os

xml_file = os.path.expanduser('~/.config/Thunar/uca.xml')
if os.path.exists(xml_file):
    try:
        tree = ET.parse(xml_file)
        root = tree.getroot()
        changed = False
        for action in root.findall('action'):
            uid = action.find('unique-id')
            if uid is not None and uid.text == 'kawaiintu-tilix-here':
                root.remove(action)
                changed = True
        if changed:
            tree.write(xml_file, encoding='UTF-8', xml_declaration=True)
    except Exception:
        pass
"

if ! grep -q "kawaiintu-compress-zip" "$UCA_FILE"; then
    cat << 'EOF' > /tmp/thunar-compress.xml
<action>
    <icon>application-zip</icon>
    <name>Compress to ZIP</name>
    <unique-id>kawaiintu-compress-zip</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="ZIP Compression" --text="Enter output filename:" --entry-text="Archive.zip"); if [ -n "$NAME" ]; then zip -r "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to ZIP</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
<action>
    <icon>application-x-xz-compressed-tar</icon>
    <name>Compress to tar.xz</name>
    <unique-id>kawaiintu-compress-tarxz</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="tar.xz Compression" --text="Enter output filename:" --entry-text="Archive.tar.xz"); if [ -n "$NAME" ]; then tar -cJf "$NAME" "$@"; fi' _ %N</command>
    <description>Instantly compress selected items to tar.xz</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
EOF
    cp "$UCA_FILE" "${UCA_FILE}.bak"
    awk '/<\/actions>/{system("cat /tmp/thunar-compress.xml")}1' "${UCA_FILE}.bak" > "$UCA_FILE"
    rm -f /tmp/thunar-compress.xml
fi

killall thunar 2>/dev/null || true

# ---------------------------------------------------------
# 7. Set as default file manager & Create dummy templates
# ---------------------------------------------------------
xdg-mime default thunar.desktop inode/directory
mkdir -p ~/Templates 2>/dev/null
touch ~/Templates/"Text File.txt" 2>/dev/null

echo ">> Thunar setup is fully completed (with Custom Actions)."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
