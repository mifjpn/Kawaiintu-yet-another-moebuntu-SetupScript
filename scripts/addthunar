#!/bin/bash
# Kawaiintu Setup Helper - Add Thunar

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m         Installing Thunar               \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. aptでのインストール（圧縮・解凍ツールも同時インストール）
echo ">> Updating apt and installing Thunar & Archive tools..."
sudo apt update >/dev/null 2>&1
# thunarの基本パッケージに加え、一撃圧縮用のzenityや標準解凍ツールのfile-roller等を追加
sudo apt -y install thunar thunar-archive-plugin thunar-volman file-roller zip unzip xz-utils zenity

# ---------------------------------------------------------
# 2. Thunarのアイコン修正 (~/.localへの完全な上書き配置)
# ---------------------------------------------------------
echo ">> Configuring local menu icon for Thunar..."
LOCAL_APP_DIR="$HOME/.local/share/applications"
mkdir -p "$LOCAL_APP_DIR"

# もし過去の遺物（kawaiintu-thunarなど）があれば削除
rm -f "$LOCAL_APP_DIR/kawaiintu-thunar.desktop"
rm -f "$LOCAL_APP_DIR/thunar.desktop"

# システムの元の設定ファイルをローカルにコピー
if [ -f /usr/share/applications/thunar.desktop ]; then
    cp /usr/share/applications/thunar.desktop "$LOCAL_APP_DIR/"
    
    # アイコン指定をGNOME標準の汎用ファイラアイコン（テーマ対応）に書き換え
    sed -i 's/^Icon=.*/Icon=system-file-manager/' "$LOCAL_APP_DIR/thunar.desktop"
    
    # 確実に関連付けさせるために、ファイル内に StartupWMClass が無ければ追記
    if ! grep -q "^StartupWMClass=" "$LOCAL_APP_DIR/thunar.desktop"; then
        echo "StartupWMClass=Thunar" >> "$LOCAL_APP_DIR/thunar.desktop"
    fi
    
    update-desktop-database "$LOCAL_APP_DIR" >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------
# 3. Dock（お気に入り）への追加
# ---------------------------------------------------------
echo ">> Replacing Nautilus with Thunar in dock favorites..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)

CLEAN_FAVORITES=$(echo "$FAVORITES" | sed -e "s/'org.gnome.Nautilus.desktop', //g" -e "s/, 'org.gnome.Nautilus.desktop'//g" -e "s/'org.gnome.Nautilus.desktop'//g" \
                                          -e "s/'kawaiintu-thunar.desktop', //g" -e "s/, 'kawaiintu-thunar.desktop'//g" -e "s/'kawaiintu-thunar.desktop'//g" \
                                          -e "s/'thunar.desktop', //g" -e "s/, 'thunar.desktop'//g" -e "s/'thunar.desktop'//g")

NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed -E "s/(\['[^']+', )/\1'thunar.desktop', /")

if [[ "$NEW_FAVORITES" == "$CLEAN_FAVORITES" ]]; then
    NEW_FAVORITES=$(echo "$CLEAN_FAVORITES" | sed "s/\]/, 'thunar.desktop'\]/" | sed "s/\[, /\[/")
fi

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Done. Nautilus removed and Thunar added to favorites."

# ---------------------------------------------------------
# 4. Thunar (XFCE) 固有のターミナル呼び出し設定 (Tilixラッパー対応)
# ---------------------------------------------------------
echo ">> Configuring terminal settings for Thunar (XFCE base)..."
mkdir -p ~/.config/xfce4
mkdir -p ~/.local/share/xfce4/helpers

cat << 'EOF' > ~/.config/xfce4/helpers.rc
TerminalEmulator=custom-TerminalEmulator
EOF

if [ -f /usr/local/bin/tilix-wrapper ]; then
    WRAPPER_PATH="/usr/local/bin/tilix-wrapper"
else
    WRAPPER_PATH="x-terminal-emulator"
fi

cat << EOF > ~/.local/share/xfce4/helpers/custom-TerminalEmulator.desktop
[Desktop Entry]
NoDisplay=true
Version=1.0
Encoding=UTF-8
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
X-XFCE-CommandsWithParameter=$WRAPPER_PATH -e "%s"
Icon=tilix
Name=Custom Terminal Wrapper
EOF

# ---------------------------------------------------------
# 5. Thunar カスタムアクション (uca.xml) への「一撃圧縮」追加
# ---------------------------------------------------------
echo ">> Injecting direct compression actions to Thunar (uca.xml)..."
UCA_DIR="$HOME/.config/Thunar"
UCA_FILE="$UCA_DIR/uca.xml"

mkdir -p "$UCA_DIR"

# uca.xmlが存在しない場合は、システムのデフォルトからコピーするか空の枠を作る
if [ ! -f "$UCA_FILE" ]; then
    if [ -f "/etc/xdg/Thunar/uca.xml" ]; then
        cp /etc/xdg/Thunar/uca.xml "$UCA_FILE"
    else
        echo '<?xml encoding="UTF-8" version="1.0"?><actions></actions>' > "$UCA_FILE"
    fi
fi

# すでに登録済みでなければ、ZIPとtar.xzのアクションを追記する
if ! grep -q "kawaiintu-compress-zip" "$UCA_FILE"; then
    cat << 'EOF' > /tmp/thunar-compress.xml
<action>
    <icon>application-zip</icon>
    <name>選択項目を ZIP に圧縮</name>
    <unique-id>kawaiintu-compress-zip</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="ZIP圧縮" --text="保存するファイル名を入力:" --entry-text="Archive.zip"); if [ -n "$NAME" ]; then zip -r "$NAME" "$@"; fi' _ %N</command>
    <description>選択したファイル/フォルダを即座にZIP圧縮します</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
<action>
    <icon>application-x-xz-compressed-tar</icon>
    <name>選択項目を tar.xz に圧縮</name>
    <unique-id>kawaiintu-compress-tarxz</unique-id>
    <command>bash -c 'NAME=$(zenity --entry --title="tar.xz圧縮" --text="保存するファイル名を入力:" --entry-text="Archive.tar.xz"); if [ -n "$NAME" ]; then tar -cJf "$NAME" "$@"; fi' _ %N</command>
    <description>選択したファイル/フォルダを即座にtar.xz圧縮します</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
</action>
EOF
    cp "$UCA_FILE" "${UCA_FILE}.bak"
    awk '/<\/actions>/{system("cat /tmp/thunar-compress.xml")}1' "${UCA_FILE}.bak" > "$UCA_FILE"
    rm -f /tmp/thunar-compress.xml
fi

# ---------------------------------------------------------
# 6. デフォルトファイルマネージャーの指定
# ---------------------------------------------------------
xdg-mime default thunar.desktop inode/directory

echo ">> Thunar setup is fully completed (with Compression Actions)."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
