#!/bin/bash
# Kawaiintu Setup Helper - Remove Nemo

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m              Removing Nemo              \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. Remove from Dock and restore Nautilus (Bulletproof Regex Injection)
echo ">> Removing Nemo and restoring Nautilus to dock..."
FAVORITES=$(gsettings get org.gnome.shell favorite-apps)
export FAVORITES

NEW_FAVORITES=$(python3 << 'EOF'
import os, re

# Safely get the raw string via environment variable
raw = os.environ.get('FAVORITES', '')

# Extract all desktop files perfectly regardless of formatting
favs = re.findall(r"'([^']+)'", raw)

# Find the current position of Nemo before removing it
insert_idx = -1
for i, app in enumerate(favs):
    if app == 'nemo.desktop':
        insert_idx = i
        break

# Remove Nemo
favs = [x for x in favs if x != 'nemo.desktop']

# Restore Nautilus if it is missing
if 'org.gnome.Nautilus.desktop' not in favs:
    if insert_idx != -1:
        # Insert Nautilus exactly where Nemo used to be
        favs.insert(insert_idx, 'org.gnome.Nautilus.desktop')
    else:
        # If Nemo wasn't in the dock either, append Nautilus to the end
        favs.append('org.gnome.Nautilus.desktop')

# Format output for gsettings
print('[' + ', '.join([f"'{x}'" for x in favs]) + ']')
EOF
)

gsettings set org.gnome.shell favorite-apps "$NEW_FAVORITES"
echo ">> Nautilus has been restored to favorites."

# 2. Reset Cinnamon terminal settings (Clean up native integration)
echo ">> Resetting Cinnamon terminal settings..."
gsettings reset org.cinnamon.desktop.default-applications.terminal exec 2>/dev/null || true
gsettings reset org.cinnamon.desktop.default-applications.terminal exec-arg 2>/dev/null || true

# 3. Purge Nemo and clean up dependencies
echo ">> Purging Nemo and cleaning up dependencies..."
sudo apt purge -y nemo >/dev/null 2>&1
sudo apt autoremove -y >/dev/null 2>&1

# 4. Reset default file manager to Nautilus (GNOME standard)
xdg-mime default org.gnome.Nautilus.desktop inode/directory

echo ">> Nemo has been successfully removed."
echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
