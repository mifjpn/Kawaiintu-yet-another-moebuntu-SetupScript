#!/bin/bash
# Kawaiintu Setup Helper - Base Settings (Extension Manager)

echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"
echo -e "\x1b[36;01m  Installing Base Setup & User Themes    \x1b[39;49;00m"
echo -e "\x1b[36;01m=========================================\x1b[39;49;00m"

# 1. 必須パッケージのインストール
echo ">> Updating apt and installing dependencies..."
sudo apt update >/dev/null 2>&1
# READMEに合わせて gnome-tweaks も一緒にインストール
sudo apt -y install gnome-shell-extension-manager gnome-tweaks >/dev/null 2>&1
echo ">> Dependencies installed."

# 2. ユーザーへのGUI操作インストラクション
echo ""
echo -e "\x1b[33;01m============================================================\x1b[39;49;00m"
echo -e "\x1b[33;01m [ACTION REQUIRED] Please setup the 'User Themes' extension \x1b[39;49;00m"
echo -e "\x1b[33;01m============================================================\x1b[39;49;00m"
echo " 1. The Extension Manager will now open automatically."
echo " 2. Go to the 'Browse' tab and search for 'User Themes'."
echo " 3. Click 'Install'."
echo " 4. Go back to the 'Installed' tab and make sure it is ON."
echo " 5. Close the window when finished to continue the script."
echo "============================================================"
echo ">> Launching Extension Manager..."

# Extension Managerを起動（ユーザーが閉じるまでスクリプトはここで待機）
extension-manager >/dev/null 2>&1

# 3. User Themesのスキーマをシステムに登録（gsettingsエラー回避のハック）
echo ">> Applying User Themes schema to system..."
SCHEMA_SRC="$HOME/.local/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas/org.gnome.shell.extensions.user-theme.gschema.xml"
SCHEMA_DEST="/usr/share/glib-2.0/schemas"

# ユーザーが実際にインストールしてファイルが存在する場合のみコピーとコンパイルを実行
if [ -f "$SCHEMA_SRC" ]; then
  sudo cp "$SCHEMA_SRC" "$SCHEMA_DEST"
  sudo glib-compile-schemas "$SCHEMA_DEST"
  echo ">> Schema compiled successfully."
else
  echo ">> Notice: User Themes schema not found."
  echo "   (Make sure you have installed 'User Themes' properly.)"
fi

echo ""
echo -n "Hit Any Key to return to menu: "
read -r -n 1 -s answer
echo ""
